+const parenthesized = /\([^()]*\)/g;
+
+const linkUrl = /\(https?:[^()]*\)/g;
+
+function comparableName(name: string): string {
+  return name
+    .normalize('NFKD')
+    .replace(/\p{M}/gu, '')
+    .toLowerCase()
+    .replace(/[^\p{L}\p{N}]+/gu, ' ')
+    .trim();
+}
+
+function candidateNamed(
+  candidates: readonly AccountCandidate[],
+  accountName: string | null,
+): AccountCandidate | undefined {
+  if (accountName === null) return undefined;
+
+  const name = accountName.replace(linkUrl, ' ');
+
+  for (const wanted of [name, name.replace(parenthesized, ' ')].map(comparableName)) {
+    if (wanted === '') continue;
+
+    const named = candidates.filter(({ name }) => name !== null && comparableName(name) === wanted);
+
+    if (named.length > 0) return named.length === 1 ? named[0] : undefined;
+  }
+
+  return undefined;
+}
