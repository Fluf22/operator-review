+const groupAccounts = [
+  { id: '001Qy00000AbCdEIAQ', name: 'Northwind Retail' },
+  { id: '001Qy00000FgHiJIAS', name: 'Northwind Crème Group' },
+  { id: '001Qy00000KlMnOIAU', name: 'Northwind Logistics' },
+];
+
+test('a domain shared by several accounts resolves to the one the source names', async () => {
+  const match = await findAccount(
+    signal({ accountName: 'northwind creme group (EMEA)' }),
+    stubSession({ domains: groupAccounts }),
+  );
+
+  expect(match.kind === 'found' && match.foundBy).toBe('domain-and-name');
+  expect(match.kind === 'found' && match.accountId).toBe('001Qy00000FgHiJIAS');
+});
+
+test('a shared domain stays ambiguous unless exactly one of its accounts has the name', async () => {
+  const twins = [...groupAccounts, { id: '001Qy00000PqRsTIAW', name: 'Northwind-Retail' }];
+
+  for (const [accountName, domains] of [
+    [null, groupAccounts],
+    ['Northwind', groupAccounts],
+    ['Northwind Retail', twins],
+  ] as const) {
+    await expect(
+      findAccount(signal({ accountName }), stubSession({ domains: [...domains] })),
+    ).resolves.toMatchObject({ kind: 'ambiguous', foundBy: 'domain' });
+  }
+});
+
+const regionalAccounts = [
+  { id: '001Qy00000AbCdEIAQ', name: 'Northwind (EMEA)' },
+  { id: '001Qy00000KlMnOIAU', name: 'Northwind Holdings' },
+];
+
+test('an account whose qualifier in parentheses the source does not name is never picked', async () => {
+  for (const accountName of ['Northwind (US)', 'Northwind']) {
+    await expect(
+      findAccount(signal({ accountName }), stubSession({ domains: regionalAccounts })),
+    ).resolves.toMatchObject({ kind: 'ambiguous', foundBy: 'domain' });
+  }
+});
+
+test('an account with a qualifier in parentheses is found by its full name', async () => {
+  const match = await findAccount(
+    signal({ accountName: 'northwind (emea)' }),
+    stubSession({
+      domains: [...regionalAccounts, { id: '001Qy00000FgHiJIAS', name: 'Northwind (US)' }],
+    }),
+  );
+
+  expect(match.kind === 'found' && match.accountId).toBe('001Qy00000AbCdEIAQ');
+});
+
+test('several accounts with the whole name stay ambiguous though one has the name without parentheses', async () => {
+  const match = await findAccount(
+    signal({ accountName: 'Northwind (EMEA)' }),
+    stubSession({
+      domains: [
+        ...regionalAccounts,
+        { id: '001Qy00000FgHiJIAS', name: 'Northwind EMEA' },
+        { id: '001Qy00000PqRsTIAW', name: 'Northwind' },
+      ],
+    }),
+  );
+
+  expect(match).toMatchObject({ kind: 'ambiguous', foundBy: 'domain' });
+});
